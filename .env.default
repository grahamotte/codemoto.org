APPLE_TEAM_ID=xxxxxxxxxxxxxxxx # Apple Developer membership Team ID; selects the signing team for every archive and export.
APPLE_ISSUER_ID=xxxxxxxxxxxxxxxx # App Store Connect > Users and Access > Integrations > Team Keys issuer ID; identifies the API-key issuer to Apple.
APPLE_KEY_ID=xxxxxxxxxxxxxxxx # App Store Connect Team Key ID; identifies the key used to manage releases, provisioning, uploads, and notarization. Create an Admin key under Users and Access > Integrations.
APPLE_KEY_SECRET_BASE64=xxxxxxxxxxxxxxxx # Team Key private .p8 downloaded once from App Store Connect; signs API requests without a logged-in Xcode account. Encode with: base64 -i AuthKey_XXXXXXXXXX.p8
APPLE_DEVELOPMENT_CERTIFICATE_BASE64=xxxxxxxxxxxxxxxx # Apple Development identity; signs Xcode archives without using Xcode account credentials or the login Keychain. Create it under developer.apple.com/account/resources/certificates, install it, export its identity and private key as .p12, then run: base64 -i certificate.p12
APPLE_DEVELOPMENT_CERTIFICATE_PASSWORD=xxxxxxxxxxxxxxxx # Password chosen while exporting the Apple Development .p12; decrypts it for temporary keychain import.
APPLE_DEVELOPER_ID_CERTIFICATE_BASE64=xxxxxxxxxxxxxxxx # Developer ID Application identity; signs the notarized macOS app distributed through GitHub and Codeberg. Create it under developer.apple.com/account/resources/certificates, install it, export its identity and private key as .p12, then run: base64 -i certificate.p12
APPLE_DEVELOPER_ID_CERTIFICATE_PASSWORD=xxxxxxxxxxxxxxxx # Password chosen while exporting the Developer ID Application .p12; decrypts it for temporary keychain import.
APPLE_DISTRIBUTION_CERTIFICATE_BASE64=xxxxxxxxxxxxxxxx # Apple Distribution identity; signs iOS/tvOS revisions and App Store exports without using the login Keychain. Create it under developer.apple.com/account/resources/certificates, install it, export its identity and private key as .p12, then run: base64 -i certificate.p12
APPLE_DISTRIBUTION_CERTIFICATE_PASSWORD=xxxxxxxxxxxxxxxx # Password chosen while exporting the Apple Distribution .p12; decrypts it for temporary keychain import.

